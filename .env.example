# ─── Base de données ─────────────────────────────────────────────
# SQLite locale (chemin relatif au dossier prisma/).
DATABASE_URL="file:./dev.db"

# Dossier des copies internes des PDF et des enregistrements audio.
DATA_DIR="./data"

# ─── Intelligence artificielle ───────────────────────────────────
# claude-cli : utilise ton abonnement Claude via Claude Code (aucune clé API, recommandé)
# anthropic  : API Anthropic payante à l'usage (nécessite ANTHROPIC_API_KEY)
# none       : sans IA (extraction simple, auto-évaluation)
# auto       : anthropic si ANTHROPIC_API_KEY est définie, sinon claude-cli
AI_PROVIDER="claude-cli"

# Options du fournisseur claude-cli
# CLAUDE_CLI_PATH="claude"
# CLAUDE_CLI_MODEL_SMART="opus"    # analyse des cours
# CLAUDE_CLI_MODEL_FAST="haiku"    # corrections, oral, conversation

# Options du fournisseur anthropic (ne jamais commiter de vraie clé)
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL_SMART="claude-opus-5"
# ANTHROPIC_MODEL_FAST="claude-haiku-4-5"

# Délai maximal de l'analyse d'un cours (ms)
# AI_LESSON_TIMEOUT_MS="600000"

# ─── Voix chinoise naturelle (synthèse côté serveur, mise en cache dans DATA_DIR/tts/) ───
# edge   : voix neuronales Microsoft via le service de lecture d'Edge — gratuit, sans compte (défaut).
#          Non officiel : peut cesser de fonctionner ; la voix du navigateur prend alors le relais.
# google : Google Cloud Text-to-Speech, voix Chirp 3 HD (nécessite GOOGLE_TTS_API_KEY).
# none   : voix du navigateur uniquement.
TTS_PROVIDER="edge"
# GOOGLE_TTS_API_KEY=""

# ─── Transcription de l'oral (quand la reconnaissance du navigateur ne marche pas : Brave, Arc, Firefox…) ───
# whisper : Whisper en local sur la machine, gratuit, audio jamais envoyé à un tiers (défaut).
#           Modèle (~250 Mo) téléchargé une fois dans DATA_DIR/models/ au premier usage.
# none    : pas de transcription locale (on tape sa réponse).
STT_PROVIDER="whisper"
# WHISPER_MODEL="onnx-community/whisper-small"
# Vidéos YouTube sans sous-titres : transcription Whisper (nécessite yt-dlp et ffmpeg : brew install yt-dlp ffmpeg).
# YTDLP_PATH="yt-dlp"
# FFMPEG_PATH="ffmpeg"
# WHISPER_VIDEO_MAX_MINUTES="15"
