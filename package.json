{
  "name": "chinese-learning-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "setup": "prisma migrate deploy && prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:e2e",
    "postinstall": "prisma generate",
    "dev:https": "next dev --experimental-https -H 0.0.0.0",
    "inspect-pdf": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/inspect-pdf.ts",
    "classify-themes": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/classify-themes.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@huggingface/transformers": "^4.3.0",
    "@mozilla/readability": "^0.6.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "msedge-tts": "^2.0.8",
    "next": "16.3.6",
    "opencc-js": "^1.4.2",
    "prisma": "^6.19.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
